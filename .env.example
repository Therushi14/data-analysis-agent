# Copy to `.env` and fill in your key. NEVER commit the real .env.

# Which LLM provider to use: "groq" (default) or "gemini".
LLM_PROVIDER=groq

# --- Groq (default; generous free-tier request limits) ---
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (alternative provider) ---
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-3.6-flash

# Optional overrides (defaults shown).
MAX_STEPS=8
MAX_CONSECUTIVE_FAILURES=3
SANDBOX_TIMEOUT_S=15
TEMPERATURE=0.1
STDOUT_CHAR_CAP=8000
