# Copy to `.env` and fill in your key. NEVER commit the real .env.
GEMINI_API_KEY=

# Optional backup key (e.g. a second project). Used automatically when the
# primary key hits its quota — free-tier limits are per-project-per-model.
GEMINI_API_KEY_BACKUP=

# Optional overrides (defaults shown). Pro models need paid quota; the latest
# Flash works on the free tier.
GEMINI_MODEL=gemini-3.6-flash
MAX_STEPS=8
MAX_CONSECUTIVE_FAILURES=3
SANDBOX_TIMEOUT_S=15
TEMPERATURE=0.1
STDOUT_CHAR_CAP=8000
